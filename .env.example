# Backend (ver backend/.env.example para el detalle completo)
APP_ENV=development
APP_NAME=Nexora Group
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_dev
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
EVIDENCE_BACKEND=none
EVIDENCE_CONTAINER_NAME=evidence
MAX_EVIDENCE_MB=25
AZURE_KEY_VAULT_URI=
AZURE_STORAGE_ACCOUNT_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Frontend local únicamente: Vite proxifica /api al backend de desarrollo.
# Producción NO debe usar /api relativo; Deploy Azure inyecta el HTTPS
# absoluto de Container Apps y el build falla cerrado si falta.
VITE_API_BASE_URL=/api
