APP_ENV=development
APP_NAME=Nexora Group
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_dev
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173

# Se crea un único Administrator si no existen usuarios y ambas variables
# están definidas. Dejar vacío para omitir el bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

EVIDENCE_BACKEND=none
EVIDENCE_CONTAINER_NAME=evidence
MAX_EVIDENCE_MB=25

# Azure (producción). Vacío en local/dev: no se contacta Azure.
AZURE_KEY_VAULT_URI=
AZURE_STORAGE_ACCOUNT_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=
