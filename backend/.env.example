APP_ENV=development
APP_NAME=Nexora Group
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_dev
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173

# Se crea un único Administrator si no existen usuarios y ambas variables
# están definidas. Dejar vacío para omitir el bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

EVIDENCE_BACKEND=none
EVIDENCE_CONTAINER_NAME=evidence
MAX_EVIDENCE_MB=25

# Azure (producción). Vacío en local/dev: no se contacta Azure.
AZURE_KEY_VAULT_URI=
AZURE_STORAGE_ACCOUNT_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Supabase / Render (ver docs/RENDER_SUPABASE.md).
# Al activar EVIDENCE_BACKEND=supabase, completar TODOS estos campos.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# FRONTEND_DIST_DIR solo para servir un build local; Dockerfile.render lo define.
# FRONTEND_DIST_DIR=/absolute/path/to/frontend/dist
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
EDIT_ACCESS_REQUIRED=true
EDIT_ACCESS_TOKEN_SALT=
EDIT_ACCESS_TOKEN_DIGEST=
